# Sanity project settings. Create a project and dataset, then fill in the ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read-only token for server-side reads of non-public data.
# Never use a write token here or expose a token with a NEXT_PUBLIC_ prefix.
# SANITY_API_READ_TOKEN=

# Required for signed Sanity webhook cache revalidation.
# SANITY_REVALIDATE_SECRET=

# Email delivery (optional)
# RESEND_API_KEY=
# SEND_FROM_EMAIL=
# APP_URL=http://localhost:3000

# Google Tag Manager (optional; analytics tags load only after visitor consent)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
